# .env cho SERVER — đặt cạnh docker-compose.prod.yaml, đổi tên thành `.env`.
#
# Compose đọc file này cho hai việc: thay `${...}` trong file compose, và truyền
# biến vào container. Nên TAG và REGISTRY cũng ở đây.

# ── Image ─────────────────────────────────────────────────────────────
REGISTRY=registry.ten-mien.vn/quilder
TAG=v1.0.0

# ── Postgres ──────────────────────────────────────────────────────────
# DATABASE_URL KHÔNG khai ở đây. File compose tự ghép nó từ ba biến dưới, để
# service `postgres` và app không thể lệch thông tin đăng nhập.
POSTGRES_USER=quilder
# BẮT BUỘC điền. Rỗng thì Postgres từ chối khởi tạo, container thoát ngay,
# và app sẽ loop vô hạn với "Can't reach database server".
#   openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_DB=quilder

# Chỉ đặt khi Postgres KHÔNG phải service `postgres` trong file compose này.
# Host là TÊN SERVICE, cổng là cổng NỘI BỘ của container (5432), không phải
# cổng publish ra ngoài.
#DB_HOST=db
#DB_PORT=5432

# Hoặc bỏ qua hết ba biến POSTGRES_* ở trên và khai thẳng, khi DB nằm ngoài
# compose này (managed service, hoặc Postgres của một stack khác):
#DATABASE_URL=postgresql://user:pass@10.0.0.5:5432/quilder?schema=public

# ── Bắt buộc ──────────────────────────────────────────────────────────
# openssl rand -base64 48
AUTH_SECRET=

# URL công khai của site — TUỲ CHỌN: đặt ở màn cài đặt lần đầu / Cài đặt › Tên miền.
# Nếu khai ở đây thì GHI ĐÈ giá trị trong Cài đặt (ô URL bị khoá). Chỉ giữ cho môi
# trường đã chạy bằng env từ trước.
#SITE_URL=https://ten-mien.vn

# Đặt "true" trên STAGING. Nó thêm `X-Robots-Tag: noindex, nofollow` lên MỌI
# response, cho robots.txt trả `Disallow: /`, và cho sitemap.xml rỗng.
#
# Mặc định (không khai) là CHO PHÉP index — mặc định phải là hành vi của site
# thật, vì quên biến này trên production sẽ lặng lẽ xoá site khỏi Google.
#SITE_NOINDEX=true

# ── Kho asset ─────────────────────────────────────────────────────────
# S3_ENDPOINT để RỖNG với AWS thật (virtual-host style). Có giá trị = path-style
# (MinIO). Đặt sai là dev chạy còn production 404.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=ap-southeast-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# URL mà TRÌNH DUYỆT tải ảnh. Đừng đổi thành tên service nội bộ — trình duyệt
# chạy trên máy khách, không nằm trong docker network.
S3_PUBLIC_BASE_URL=https://cdn.ten-mien.vn
#
# Host của URL này PHẢI nằm trong ASSET_HOSTS lúc BUILD image (Dockerfile, `pnpm release`):
# image build với host khác thì mọi ảnh trả 400 — đổi CDN là phải build lại image.

# ── Tuỳ chọn ──────────────────────────────────────────────────────────
PUBLIC_API_ORIGINS=
