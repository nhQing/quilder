# ═══════════════════════════════════════════════════════════════════════════════
#  Quilder — biến môi trường
#
#  Chỉ những thứ màn Cài đặt KHÔNG làm được mới nằm ở đây. Tên site, logo, favicon,
#  theme sáng/tối, URL site, SEO, robots.txt, sitemap và tài khoản quản trị đều đặt
#  trong builder (màn cài đặt lần đầu → Cài đặt).
#
#  Bốn nhóm, theo thứ tự quan trọng:
#    1. BẮT BUỘC LÚC BUILD  — đóng vào bản build; đổi là phải build lại.
#    2. BẮT BUỘC LÚC CHẠY   — thiếu là server không lên (entrypoint.sh kiểm).
#    3. TUỲ CHỌN            — có mặc định hợp lý.
#    4. CHỈ CHO DEV/SCRIPT  — server không đọc; để trống trên production.
# ═══════════════════════════════════════════════════════════════════════════════


# ── 1. BẮT BUỘC LÚC BUILD ─────────────────────────────────────────────────────

# Gói dự án (projects/<tên>/ — một repo git riêng, clone vào đó): CSS, font, ảnh,
# composite, effect riêng của một website. Trống = Quilder thuần. Sai tên gói thì build
# DỪNG. Docker: `pnpm release` tự truyền `--build-arg QUILDER_PROJECT=…`.
# Xem projects/example/README.md.
QUILDER_PROJECT=""

# Host kho ảnh (CDN hoặc S3 public) cho `next/image`. Bị đóng vào bản build — thiếu
# nó thì mọi ảnh raster trả 400 và trang chỉ còn chữ. Nhiều host cách nhau dấu phẩy;
# không ghi scheme thì coi là https. Để trống thì lấy host của S3_PUBLIC_BASE_URL.
#
# Build Docker KHÔNG đọc file này (.dockerignore loại .env): `pnpm release` tự đọc
# dòng dưới rồi truyền `--build-arg ASSET_HOSTS=…`; build tay thì tự truyền.
# `next build` production không có host nào là build DỪNG — xem scripts/asset-hosts.mjs.
ASSET_HOSTS=""


# ── 2. BẮT BUỘC LÚC CHẠY ──────────────────────────────────────────────────────

# Postgres. Dev: docker compose (`pnpm db:up`) mở cổng 5433 để không đụng instance 5432 sẵn có.
DATABASE_URL="postgresql://builder:builder@localhost:5433/quilder?schema=public"

# Ký JWT phiên đăng nhập (cookie httpOnly) và dẫn xuất mã cài đặt. Tối thiểu 32 ký tự.
# Sinh bằng: openssl rand -base64 48
AUTH_SECRET=""

# Kho asset (ảnh, font, file tải lên).
#
# Production: AWS S3 thật — để S3_ENDPOINT RỖNG, và đặt S3_PUBLIC_BASE_URL thành gốc
# CloudFront hoặc endpoint bucket.
#
# Dev: MinIO trong docker-compose. Đặt
#   S3_ENDPOINT="http://localhost:9000"
#   S3_PUBLIC_BASE_URL="http://localhost:9000/quilder-assets"
# rồi tạo bucket (tên container xem `docker ps`, mặc định có đuôi -s3):
#   docker exec <container-s3> mc alias set local http://localhost:9000 builder builderbuilder
#   docker exec <container-s3> mc mb --ignore-existing local/quilder-assets
#   docker exec <container-s3> mc anonymous set download local/quilder-assets
#
# "download" là CHỈ ĐỌC. Đừng dùng "public" — nó mở cả quyền ghi.
#
# S3_ENDPOINT cũng quyết định kiểu địa chỉ: có endpoint thì path-style (MinIO), rỗng
# thì virtual-host (AWS). Đặt sai là dev chạy còn production 404.
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION=""
S3_PUBLIC_BASE_URL=""


# ── 3. TUỲ CHỌN ───────────────────────────────────────────────────────────────

# Cookie đăng nhập có cờ Secure (chỉ gửi qua HTTPS). Trống = Secure trên production,
# không Secure trên dev. Đặt "false" CHỈ cho môi trường nội bộ mở bằng http://<ip>:<cổng>
# — không có nó, đăng nhập xong trình duyệt vứt cookie và form login hiện lại trống.
COOKIE_SECURE=""

# Bản staging: "true" thì robots.txt chặn tất, sitemap rỗng, mọi trang có X-Robots-Tag
# noindex. THẮNG mọi cấu hình robots trong Cài đặt. Production để trống.
SITE_NOINDEX=""

# URL đầy đủ của site công khai. TUỲ CHỌN: đặt ở màn cài đặt / Cài đặt › Tên miền.
# Nếu đặt thì GHI ĐÈ giá trị trong Cài đặt và ô URL ở builder bị khoá — chỉ giữ cho
# môi trường đã chạy bằng env từ trước. Thứ tự: SITE_URL → Cài đặt → http://localhost:3001.
# SITE_URL="https://ten-mien.vn"

# Gốc URL của BUILDER mà hướng dẫn "Kết nối Claude" in ra. Trống = lấy từ request (đúng
# trong đa số trường hợp). Đặt khi builder nằm sau proxy không chuyển x-forwarded-host.
# PUBLIC_URL="https://builder.ten-mien.vn"

# Origin được phép gọi /api/public/v1 từ trình duyệt. Rỗng = chỉ server và app gọi được
# (app mobile không gửi Origin nên không bị chặn). "*" cho phép mọi origin.
PUBLIC_API_ORIGINS=""


# ── 4. CHỈ CHO DEV / SCRIPT — server không đọc ────────────────────────────────

# KHÔNG phải tài khoản đăng nhập builder. Tài khoản thật nằm trong DB, tạo ở màn cài đặt
# lần đầu (hoặc `pnpm user:create`). Hai dòng này chỉ cho script và e2e chạy THẲNG vào DB
# dev đăng nhập thay người (scripts/api-client.ts, e2e/auth.setup.ts…). Stack e2e
# (`pnpm e2e`) tự tạo tài khoản riêng, không cần chúng. Production: để trống.
BUILDER_EMAIL=""
BUILDER_PASSWORD=""

# Cổng mà e2e gõ vào khi chạy thẳng vào dev server. Mặc định đã là 3001.
E2E_BASE_URL="http://localhost:3001"

# `pnpm release`: registry BẮT BUỘC, tên image tuỳ chọn (mặc định quilder → quilder và
# quilder-bootstrap). Xem scripts/release.mjs.
RELEASE_REGISTRY=""
# RELEASE_IMAGE="quilder"

# Tên stack Docker của `pnpm db:up` (tiền tố container và volume) và tên DB Postgres.
# Mặc định quilder. Máy đã có dữ liệu dưới tên cũ thì đặt đúng tên cũ để giữ volume.
# COMPOSE_PROJECT_NAME="quilder"
# POSTGRES_DB="quilder"
