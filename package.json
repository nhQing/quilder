{
  "name": "quilder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "next dev",
    "dev:clean": "node scripts/clean-next.mjs && next dev",
    "clean": "node scripts/clean-next.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "docker:build": "node scripts/docker-stack.mjs build",
    "docker:up": "node scripts/docker-stack.mjs up",
    "docker:down": "node scripts/docker-stack.mjs down",
    "docker:logs": "node scripts/docker-stack.mjs logs",
    "release": "node scripts/release.mjs",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "tokens:import": "tsx scripts/import-tokens.ts",
    "effects:sync": "node --env-file=.env --import tsx scripts/sync-effects.ts",
    "effect:preset": "node --env-file=.env --import tsx scripts/effect-preset.ts",
    "check:tokens": "tsx scripts/check-tokens.ts",
    "prove:rollback": "tsx scripts/prove-rollback.ts",
    "prove:seq": "node --env-file=.env --conditions=react-server --import tsx scripts/prove-version-seq.ts",
    "verify": "pnpm db:generate && pnpm typecheck && pnpm test && pnpm check:tokens",
    "verify:live": "pnpm typecheck && pnpm test && pnpm check:tokens",
    "e2e": "node scripts/e2e-stack.mjs run",
    "e2e:ci": "node scripts/e2e-stack.mjs ci",
    "e2e:up": "node scripts/e2e-stack.mjs up",
    "e2e:test": "node scripts/e2e-stack.mjs test",
    "e2e:restart": "node scripts/e2e-stack.mjs restart",
    "e2e:down": "node scripts/e2e-stack.mjs down",
    "e2e:shared": "node scripts/e2e-stack.mjs shared",
    "seed:second": "tsx scripts/seed-second-page.ts",
    "seed:collections": "node --env-file=.env --import tsx scripts/seed-collections.ts",
    "user:create": "tsx scripts/create-user.ts",
    "site:domain": "node --env-file=.env --import tsx scripts/set-site-domain.ts",
    "mcp:token": "node --env-file=.env --import tsx scripts/mint-service-token.ts",
    "mcp:serve": "node mcp/server.mjs",
    "mcp:smoke": "node mcp/smoke.mjs",
    "prove:sealed": "node --env-file=.env --import tsx scripts/prove-release-sealed.ts",
    "check:layout": "node --env-file=.env --import tsx scripts/check-layout.ts",
    "api:types": "node --import tsx scripts/gen-api-types.ts",
    "docs:gen": "node --conditions=react-server --import tsx scripts/gen-docs.ts",
    "docs:check": "node --conditions=react-server --import tsx scripts/gen-docs.ts --check",
    "mcp:snapshot": "node --conditions=react-server --import tsx scripts/mcp-snapshot.ts",
    "prove:concurrent": "node --env-file=.env --conditions=react-server --import tsx scripts/prove-concurrent-ops.ts",
    "effects:audit": "node --env-file=.env --import tsx scripts/audit-effect-params.ts",
    "assets:sweep": "node --env-file=.env --conditions=react-server --import tsx scripts/sweep-asset-holds.ts",
    "e2e:visual": "node scripts/e2e-stack.mjs visual",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1112.0",
    "@ckeditor/ckeditor5-react": "^11.2.0",
    "@fontsource/be-vietnam-pro": "5.2.5",
    "@fontsource/jetbrains-mono": "5.2.5",
    "@prisma/client": "^6.2.1",
    "@radix-ui/react-popover": "1.2.0",
    "@radix-ui/react-tooltip": "1.3.0",
    "ckeditor5": "^48.5.0",
    "clsx": "^2.1.1",
    "fflate": "0.8.2",
    "gsap": "^3.15.0",
    "jose": "^6.2.8",
    "lenis": "^1.3.26",
    "next": "^15.1.6",
    "postcss-safe-parser": "^7.0.1",
    "react": "^19.0.0",
    "react-colorful": "^5.8.0",
    "react-dom": "^19.0.0",
    "sanitize-html": "^2.17.7",
    "server-only": "^0.0.1",
    "swiper": "^14.2.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.25.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.6",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "prisma": "^6.2.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.2"
  }
}
